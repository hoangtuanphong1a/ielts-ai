# Copy thành .env (cùng thư mục) rồi sửa giá trị. .env không commit.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "postgres" hoặc "sqlite"
DB_ENGINE=postgres
POSTGRES_DB=ielts_ai
POSTGRES_USER=ielts
POSTGRES_PASSWORD=ielts_dev_pw
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# Redis (dùng cho Celery ở T0.8)
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0

# Email (T1.2 quên mật khẩu): dev in ra console của runserver
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=IELTS AI <no-reply@ielts-ai.local>
FRONTEND_URL=http://localhost:5173

# Celery: 1 = chạy task ngay trong request (không cần worker)
CELERY_EAGER=0

# Kiểm tra ngữ pháp (T2.3): LanguageTool trong docker-compose
LANGUAGETOOL_PORT=8081
LANGUAGETOOL_URL=http://127.0.0.1:8081
